{
  "uid": "sensor-hub",
  "title": "Sensor Hub",
  "tags": [
    "sensor-hub"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Window notifications",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "sensorhub-pg"
        },
        "enable": true,
        "iconColor": "#f2a33c",
        "target": {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"time\", message AS text, new_state AS tags\nFROM notifications\nWHERE $__timeFilter(created_at)"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temperature",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sensorhub-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sensorhub-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"time\", device_id AS metric, temperature_c AS value\nFROM measurements\nWHERE $__timeFilter(created_at)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 300000,
            "insertNulls": 300000
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              },
              {
                "id": "custom.insertNulls",
                "value": false
              },
              {
                "id": "custom.spanNulls",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Humidity",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sensorhub-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sensorhub-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"time\", device_id AS metric, humidity_pct AS value\nFROM measurements\nWHERE $__timeFilter(created_at)\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sensorhub-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeFrom()::timestamptz AS \"time\", humidity_open_pct AS \"open limit\", humidity_close_pct AS \"close limit\" FROM threshold_settings\nUNION ALL\nSELECT $__timeTo()::timestamptz, humidity_open_pct, humidity_close_pct FROM threshold_settings\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 300000,
            "insertNulls": 300000
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              },
              {
                "id": "custom.insertNulls",
                "value": false
              },
              {
                "id": "custom.spanNulls",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CO₂",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sensorhub-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sensorhub-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"time\", device_id AS metric, co2_ppm AS value\nFROM measurements\nWHERE $__timeFilter(created_at)\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sensorhub-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeFrom()::timestamptz AS \"time\", co2_open_ppm AS \"open limit\", co2_close_ppm AS \"close limit\" FROM threshold_settings\nUNION ALL\nSELECT $__timeTo()::timestamptz, co2_open_ppm, co2_close_ppm FROM threshold_settings\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": 300000,
            "insertNulls": 300000
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              },
              {
                "id": "custom.insertNulls",
                "value": false
              },
              {
                "id": "custom.spanNulls",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
